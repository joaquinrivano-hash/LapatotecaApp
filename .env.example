# ─── Canal de mensajería ──────────────────────────────────────────────
# "simulado" (por defecto): los mensajes quedan en la bandeja de salida de la
# app y no sale nada a la red. Sirve para demos sin cuenta de Meta.
# "whatsapp": los envíos pasan por /api/integraciones/whatsapp/enviar, que usa
# las credenciales de abajo.
NEXT_PUBLIC_CANAL_MENSAJERIA=simulado

# ─── Supabase Auth ────────────────────────────────────────────────────
# La ruta de envío de WhatsApp valida en el servidor que quien llama tenga
# sesión con rol staff o admin. Sin estas dos variables no hay sesión que
# validar y la ruta responde 401 a todo. La clave anónima es pública por
# diseño: lo que protege los datos son las políticas de la base.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── WhatsApp Business (Cloud API) ────────────────────────────────────
# Estas NO llevan NEXT_PUBLIC_: son secretas y solo las lee el servidor.
# Se sacan de developers.facebook.com → tu app → WhatsApp → Configuración.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0

# Solo para probar: apunta los envíos a otro servidor en vez de a Meta. Vacío
# significa https://graph.facebook.com, que es lo que corresponde en serio.
WHATSAPP_API_BASE=

# Token que tú inventas y repites en el panel de Meta al suscribir el webhook.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# App Secret de la app de Meta (developers.facebook.com → tu app →
# Configuración de la app → Básica). Meta firma cada aviso del webhook con él
# en la cabecera X-Hub-Signature-256; sin este valor el webhook rechaza todo.
WHATSAPP_APP_SECRET=

# Ojo: para escribirle primero a un cliente (fuera de la ventana de 24 h)
# WhatsApp exige una PLANTILLA APROBADA. Las de La Patoteca están declaradas en
# lib/integraciones/mensajeria/plantillas.ts y hay que darlas de alta con el
# mismo nombre e idioma en WhatsApp Manager.
#
# El idioma es IDIOMA_PLANTILLAS en ese mismo archivo y tiene que ser el mismo
# que elijas en el panel: si no coincide exacto, el envío falla aunque el
# nombre de la plantilla esté bien.
