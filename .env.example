# ─── Canal de mensajería ──────────────────────────────────────────────
# "simulado" (por defecto): los mensajes quedan en la bandeja de salida de la
# app y no sale nada a la red. Sirve para demos sin cuenta de Meta.
# "whatsapp": los envíos pasan por /api/integraciones/whatsapp/enviar, que usa
# las credenciales de abajo.
NEXT_PUBLIC_CANAL_MENSAJERIA=simulado

# ─── WhatsApp Business (Cloud API) ────────────────────────────────────
# Estas NO llevan NEXT_PUBLIC_: son secretas y solo las lee el servidor.
# Se sacan de developers.facebook.com → tu app → WhatsApp → Configuración.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0

# Solo para probar: apunta los envíos a otro servidor en vez de a Meta. Vacío
# significa https://graph.facebook.com, que es lo que corresponde en serio.
WHATSAPP_API_BASE=

# Token que tú inventas y repites en el panel de Meta al suscribir el webhook.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Ojo: para escribirle primero a un cliente (fuera de la ventana de 24 h)
# WhatsApp exige una PLANTILLA APROBADA. Las de La Patoteca están declaradas en
# lib/integraciones/mensajeria/plantillas.ts y hay que darlas de alta con el
# mismo nombre e idioma en WhatsApp Manager.
#
# El idioma es IDIOMA_PLANTILLAS en ese mismo archivo y tiene que ser el mismo
# que elijas en el panel: si no coincide exacto, el envío falla aunque el
# nombre de la plantilla esté bien.

# ─── Origen de los datos ──────────────────────────────────────────────
# "local" (por defecto): los datos viven en el localStorage del navegador,
# sembrados con el seed. Es el prototipo: cada dispositivo tiene los suyos.
# "supabase": los datos viven en la base, compartidos, y lo que cada persona
# ve lo deciden las políticas de RLS.
NEXT_PUBLIC_ORIGEN_DATOS=local

# ─── Supabase ─────────────────────────────────────────────────────────
# Settings → API en el panel del proyecto.
#
# La llave `anon` es PÚBLICA a propósito: viaja en el paquete que descarga el
# navegador. Lo que impide que con ella se vean los datos de otro no es el
# secreto de la llave, son las políticas de RLS — por eso las migraciones de
# permisos no son un trámite.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# La llave `service_role` se salta RLS entera. NUNCA va en una variable
# NEXT_PUBLIC_ ni en este repo: se carga directo en el panel de Vercel y solo
# la lee el servidor.
#
# La usa una sola ruta: /api/equipo/invitaciones, que manda el correo de
# invitación al equipo (auth.admin.inviteUserByEmail) y revisa antes que
# quien lo pide sea Administración. Sin ella, invitar anota el correo pero no
# sale ningún correo, y la pantalla lo dice.
#
# Para que el correo LLEGUE hace falta además, en el panel de Supabase:
#   · Authentication → Emails → SMTP Settings: un remitente propio (Resend,
#     Brevo, Gmail…). El que trae Supabase solo escribe a los miembros del
#     equipo del proyecto en Supabase, y pocos correos por hora.
#   · Authentication → URL Configuration → Redirect URLs: el dominio de la
#     app, p. ej. https://lapatoteca.cl/** y https://*.vercel.app/**. Si la
#     dirección de vuelta no está en la lista, Supabase manda a la persona a
#     la portada y no a elegir su contraseña.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Google Maps (buscador de direcciones del alta) ───────────────────
# Sin llave, el alta pide dirección y comuna escritas a mano. Con llave,
# sugiere direcciones reales y saca la comuna sola.
#
# Es PÚBLICA a propósito (viaja al navegador, igual que la de Supabase): lo
# que impide que otro la use es la restricción, no el secreto. En Google
# Cloud → APIs y servicios → Credenciales, a esta llave:
#   · Restricción de aplicación: sitios web (referentes HTTP)
#       https://www.lapatoteca.cl/*  https://lapatoteca.cl/*
#       https://*.vercel.app/*       http://localhost:3000/*
#   · Restricción de API: solo "Maps JavaScript API" y "Places API (New)"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
